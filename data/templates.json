        "Faq": {
          "variants": {
            "PetFaq3": {
              "subtitle": "FAQS",
              "title1": "We\u2019re Here to Answer",
              "highlightedTitle": "Your Questions",
              "description": "Find answers to common questions about our pet care services, facilities, and the care we provide.",
              "expandLabel": "Expand answer",
              "collapseLabel": "Collapse answer",
              "items": [
                {
                  "id": "faq-services",
                  "number": "01",
                  "question": "What services do you provide at Petlimb?",
                  "answer": "We offer grooming, daycare, boarding, wellness support, and basic health care to provide a safe, comfortable, and enjoyable experience for your pet."
                },
                {
                  "id": "faq-grooming-safety",
                  "number": "02",
                  "question": "Is grooming safe for all breeds?",
                  "answer": "Yes. Our trained groomers adapt products, tools, and handling techniques to suit your pet\u2019s breed, coat type, age, and comfort level."
                },
                {
                  "id": "faq-pet-boarding",
                  "number": "03",
                  "question": "Do you offer pet boarding?",
                  "answer": "Yes. We provide secure, comfortable boarding with attentive care, regular activity, feeding, and supervision throughout your pet\u2019s stay."
                },
                {
                  "id": "faq-daycare-timings",
                  "number": "04",
                  "question": "What are your daycare timings?",
                  "answer": "Our daycare operates during regular business hours. Please contact our team before visiting to confirm the current schedule and availability."
                },
                {
                  "id": "faq-book-appointment",
                  "number": "05",
                  "question": "How do I book an appointment?",
                  "answer": "Use the Book Now button, call our care team, or send us a message with your preferred service, date, and time."
                },
                {
                  "id": "faq-vaccinations",
                  "number": "06",
                  "question": "Are vaccinations required?",
                  "answer": "Vaccination requirements depend on the selected service. Our team will explain the health records needed when your appointment is confirmed."
                },
                {
                  "id": "faq-stay-during-grooming",
                  "number": "07",
                  "question": "Can I stay with my pet during grooming?",
                  "answer": "This depends on your pet\u2019s comfort and the grooming area. Our team will recommend the calmest and safest arrangement for the session."
                },
                {
                  "id": "faq-boarding-food-bedding",
                  "number": "08",
                  "question": "Do you provide food and bedding during boarding?",
                  "answer": "Yes. Clean bedding and suitable meals can be provided, and you may also share your pet\u2019s usual diet or bring approved food when needed."
                }
              ],
              "image": "/about/1.webp",
              "imageAlt": "A golden retriever and cat resting together"
            }
          }
        },
